# Ignore artifacts from Make builds
*.o
*.mod
/bin/*
!/bin/.gitkeep
/lib/*
!/lib/.gitkeep

# Ignore user build configuration files
CMakeLists.user
Make.user
Make.user.*

# Ignore generated CMake files
build/
build-*/

# Ignore Doxygen-generated files
/doc/html

# Ignore output log files
*.out
*.err

# Ignore large local calculation datasets
/test/data/

# Ignore Python bytecode caches
__pycache__/
*.py[cod]

# This checkout is intentionally limited to GRASP source and focused tests.
# Examples, documentation, and auxiliary tooling are not synchronized.
/grasptest/
/contrib/
/doc/
/src/tool/

# Local compiler/build output and calculation products.
*.a
*.so
*.dylib
*.dat
*.sum
*.iso
*.csl
*.w
*.rwf
*.res
*.log
